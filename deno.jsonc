{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "name": "algo-trainer",
  "exports": {},
  "version": "0.0.1",
  "description": "TODO",
  "license": "GPL3",
  "author": "Andre Silva <andreswebs@pm.me>",
  "homepage": "https://github.com/andreswebs/algo-trainer",
  "repository": {
    "type": "git",
    "url": "https://github.com/andreswebs/algo-trainer.git"
  },
  "tasks": {
    "dev": "DENO_ENV=development deno run --allow-all --watch src/main.ts",
    "generate-problems": "deno run --allow-read --allow-write --allow-env --allow-run=bunx scripts/generate-problems.ts",
    "build": "deno task generate-problems && deno compile --allow-all --include=src/data/templates --include=src/data/scripts --output=bin/algo-trainer src/main.ts",
    "test": "unset AT_WORKSPACE AT_LANGUAGE AT_VERBOSE AT_QUIET AT_NO_COLOR AT_NO_EMOJI AT_CONFIG_PATH AT_TEMPLATE_STYLE && export XDG_ROOT=$(mktemp -d) && DENO_ENV=test XDG_CONFIG_HOME=$XDG_ROOT/config XDG_DATA_HOME=$XDG_ROOT/data XDG_CACHE_HOME=$XDG_ROOT/cache XDG_STATE_HOME=$XDG_ROOT/state deno test --allow-write --allow-read --allow-env",
    "test:watch": "deno test --watch --allow-write --allow-read --allow-env",
    "bench": "deno bench --allow-all",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "fmt": "bun run format",
    "fmt:check": "bun run format:check",
    "check": "deno check src/**/*.ts"
  },
  "test": {
    "exclude": ["test/helpers/assert.test.ts"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/testing": "jsr:@std/testing@1",
    "@std/cli": "jsr:@std/cli@1",
    "@std/path": "jsr:@std/path@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/yaml": "jsr:@std/yaml@1",
    "@std/json": "jsr:@std/json@1"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"]
    },
    "exclude": ["_.local-leetcode-trainer.legacy/**/*"]
  },
  "exclude": ["_.local-leetcode-trainer.legacy/", ".local/"],
  "lock": true
}
