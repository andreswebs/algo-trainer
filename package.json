{
  "name": "algo-trainer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Andre Silva <andreswebs@pm.me>",
  "homepage": "https://github.com/andreswebs/algo-trainer",
  "repository": {
    "type": "git",
    "url": "https://github.com/andreswebs/algo-trainer.git"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "generate-problems": "bun scripts/generate-problems.ts",
    "build": "bun run generate-problems && bun build --compile --asset ./src/data/templates --asset ./src/data/scripts --outfile ./bin/algo-trainer ./src/main.ts && rm -f ./.*.bun-build",
    "typecheck": "bun check --no-pretty",
    "format": "biome check --write --linter-enabled=false",
    "format:check": "biome check --linter-enabled=false",
    "lint": "biome lint --error-on-warnings",
    "lint:fix": "biome lint --write",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "verify": "bun run typecheck && biome ci --error-on-warnings && bun test"
  },
  "dependencies": {
    "@std/cli": "npm:@jsr/std__cli@^1.0.32",
    "@std/yaml": "npm:@jsr/std__yaml@^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.3"
  }
}
